load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test", "rust_test_suite")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# build.rs concatenates src/minimizer/defs/*.toml into OUT_DIR/builtin_filters.toml,
# consumed via include_str!(concat!(env!("OUT_DIR"), ...)) in minimizer/engine.rs.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {"OMP_BAZEL_BUILD": "1"},
    data = glob(["src/minimizer/defs/*.toml"]),
    edition = "2024",
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "pi-shell",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    aliases = aliases(),
    compile_data = glob([
        "src/minimizer/filters/fixtures/**",
        "src/process/*.txt",
        # The Windows console's terminfo entry (`terminfo_db.rs` `include_bytes!`).
        "src/bash/vm/zsh/terminfo/*",
    ]),
    crate_name = "pi_shell",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = select({
        # Cargo.toml `[profile.dev.package.pi-shell]`: the bash engine's
        # unoptimized frames overflow the 2 MiB test-thread stack before its
        # recursion limits hit.
        "//bazel:fastbuild": ["-Copt-level=1"],
        "//conditions:default": [],
    }),
    version = "18.15.0",
    deps = all_crate_deps(normal = True) + [
        ":build_script",
        "//crates/pi-builtins",
        "//crates/pi-vcs",
        "//crates/pi-vfs",
    ],
)

# obash: the engine as a standalone shell, for differential tests and
# benchmarks against bash. Its C `main` (`#![no_main]`) keeps the SIGPIPE
# disposition it was started with.
rust_binary(
    name = "obash",
    srcs = glob(["src/bin/obash/**/*.rs"]),
    aliases = aliases(),
    crate_name = "obash",
    crate_root = "src/bin/obash/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    # Match build.rs's Cargo-only, binary-specific linker directives.
    rustc_flags = select({
        "@platforms//os:linux": ["-Clink-arg=-no-pie"],
        "@platforms//os:macos": ["-Clink-arg=-Wl,-dead_strip_dylibs"],
        "//conditions:default": [],
    }),
    version = "18.15.0",
    deps = all_crate_deps(normal = True) + [":pi-shell"],
)

# Unit tests, including the engine, host and pi-host suites under
# `src/**/suites`, which read their data at compile time (syntax goldens,
# zsh glob tables) and at run time (testkit fixtures).
# The gate runs the target's one libtest process under
# .github/sami/libtest-bound.py, which fails a test that has made no progress
# within its .config/nextest.toml bound (240 s; no override names a pi-shell
# test) by name. Bazel's timeout must leave that bound after the longest
# correct run, and be at least twice that run: the longest of three gate runs
# (sami-checks runs 45722788663, 45722800123 and 45722811150, 2026-11-26) took
# 158.6 s, so max(2 x 158.6, 158.6 + 240) = 398.6 s: "long" (900 s), not the
# 300 s of a medium test, which a hang that starts after 60 s would reach
# unnamed.
rust_test(
    name = "pi-shell_test",
    timeout = "long",
    compile_data = glob([
        "src/bash/syntax/suites/data/**",
        "src/bash/pattern/zsh/testdata/**",
        "src/bash/vm/zle/testdata/**",
        "src/testkit/fixtures/**",
    ]),
    crate = ":pi-shell",
    data = glob(["src/testkit/fixtures/**"]),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_flags = select({
        # Cargo.toml `[profile.dev.package.pi-shell]`: the bash engine's
        # unoptimized frames overflow the 2 MiB test-thread stack before its
        # recursion limits hit.
        "//bazel:fastbuild": ["-Copt-level=1"],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "vfs_test",
    srcs = ["tests/vfs.rs"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [
        ":pi-shell",
        "//crates/pi-vfs",
    ],
)

rust_test(
    name = "minimizer_fixtures_test",
    srcs = ["tests/minimizer_fixtures.rs"],
    data = glob(["tests/fixtures/minimizer/**"]),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [":pi-shell"],
)

# The other integration tests: one rust_test per tests/*.rs, as cargo builds
# them, each with every module under a directory of tests/ (cargo makes a
# test target of a tests/*.rs file or a tests/<dir>/main.rs, and pi-shell has
# no such main.rs), such as tests/*_support and tests/zsh_oracle. Many start
# obash: cargo names its path in CARGO_BIN_EXE_obash, and so do these targets,
# relative to the runfiles root; the support modules make it absolute.
# The suite and the targets below share these values. Bazel refuses **kwargs in
# a BUILD file, so each passes them by name.
_INTEGRATION_SHARED_SRCS = glob(
    ["tests/*/**/*.rs"],
    exclude = ["tests/fixtures/**"],
)

_INTEGRATION_DATA = glob([
    "src/testkit/fixtures/**",
    "tests/fixtures/**",
]) + [":obash"]

_INTEGRATION_PROC_MACRO_DEPS = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True)

_INTEGRATION_RUSTC_ENV = {"CARGO_BIN_EXE_obash": "$(rootpath :obash)"}

_INTEGRATION_RUSTC_FLAGS = select({
    # As pi-shell_test: the engine runs in some of these test processes.
    "//bazel:fastbuild": ["-Copt-level=1"],
    "//conditions:default": [],
})

_INTEGRATION_DEPS = all_crate_deps(normal = True) + all_crate_deps(normal_dev = True) + [
    ":pi-shell",
    "//crates/pi-vfs",
]

# Tests of the suite that take timeout "long" (900 s), each from a target of
# its own below. As for pi-shell_test, the gate runs a target's one libtest
# process under .github/sami/libtest-bound.py, which fails a test that has
# made no progress within its 240 s bound by name, so Bazel's timeout must be
# at least max(2L, L + 240) s, for L the target's longest correct gate run.
# Measured in sami-checks runs 45722788663, 45722800123, 45722811150,
# 45736348441, 45762739480, 45762775961, 45777174937 and 45821320132
# (2026-11-26), each needs more than the 300 s of a medium test:
#
#   tests/<file>.rs   correct runs   L (its run)             max(2L, L + 240)
#   zsh_comp_y03      7              284.9 s (45762775961)   569.8 s
#   zsh_comp_y02      8              211.2 s (45821320132)   451.2 s
#   zle_widgets_pty   8              107.7 s (45722788663)   347.7 s
#   zsh_comp_y01      8               99.3 s (45762775961)   339.3 s
#   zle_hist_pty      8               76.9 s (45722811150)   316.9 s
#
# zsh_comp_y03 also reached the 300 s timeout in run 45821320132.
_LONG_INTEGRATION_TESTS = [
    "zsh_comp_y03",
    "zsh_comp_y02",
    "zle_widgets_pty",
    "zsh_comp_y01",
    "zle_hist_pty",
]

rust_test_suite(
    name = "pi-shell_integration_tests",
    srcs = glob(
        ["tests/*.rs"],
        exclude = [
            "tests/minimizer_fixtures.rs",
            "tests/vfs.rs",
            # Their own targets below.
            "tests/zsh_computil_args_pty.rs",
        ] + ["tests/" + f + ".rs" for f in _LONG_INTEGRATION_TESTS],
    ),
    aliases = aliases(),
    data = _INTEGRATION_DATA,
    edition = "2024",
    proc_macro_deps = _INTEGRATION_PROC_MACRO_DEPS,
    rustc_env = _INTEGRATION_RUSTC_ENV,
    rustc_flags = _INTEGRATION_RUSTC_FLAGS,
    shared_srcs = _INTEGRATION_SHARED_SRCS,
    deps = _INTEGRATION_DEPS,
)

# The tests the suite above leaves out, each as the suite makes a test: for
# tests/<file>.rs, rules_rust's rust_test_suite names it
# "<suite>_tests/<file>_test" and its crate that name with "-", "/" and "."
# made "_", so the labels and crate names stay the same.
#
# tests/zsh_computil_args_pty.rs takes timeout "eternal" (3,600 s). It took
# "long" (900 s) on 2026-11-24, when its cargo test binary took 233 to 283 s
# in 40 runs alone and Bazel's 300 s stopped it (sami-checks run
# 45351216411). Measured as _LONG_INTEGRATION_TESTS are, in the same eight
# gate runs, it needs more: of its 8 correct runs, the longest took 480.5 s
# (run 45762775961), so max(2 x 480.5, 480.5 + 240) = 961.0 s, past "long".
rust_test(
    name = "pi-shell_integration_tests_tests/zsh_computil_args_pty_test",
    timeout = "eternal",
    srcs = ["tests/zsh_computil_args_pty.rs"] + _INTEGRATION_SHARED_SRCS,
    aliases = aliases(),
    crate_name = "pi_shell_integration_tests_tests_zsh_computil_args_pty_test",
    crate_root = "tests/zsh_computil_args_pty.rs",
    data = _INTEGRATION_DATA,
    edition = "2024",
    proc_macro_deps = _INTEGRATION_PROC_MACRO_DEPS,
    rustc_env = _INTEGRATION_RUSTC_ENV,
    rustc_flags = _INTEGRATION_RUSTC_FLAGS,
    deps = _INTEGRATION_DEPS,
)

[
    rust_test(
        name = "pi-shell_integration_tests_tests/" + f + "_test",
        timeout = "long",
        srcs = ["tests/" + f + ".rs"] + _INTEGRATION_SHARED_SRCS,
        aliases = aliases(),
        crate_name = "pi_shell_integration_tests_tests_" + f + "_test",
        crate_root = "tests/" + f + ".rs",
        data = _INTEGRATION_DATA,
        edition = "2024",
        proc_macro_deps = _INTEGRATION_PROC_MACRO_DEPS,
        rustc_env = _INTEGRATION_RUSTC_ENV,
        rustc_flags = _INTEGRATION_RUSTC_FLAGS,
        deps = _INTEGRATION_DEPS,
    )
    for f in _LONG_INTEGRATION_TESTS
]

# obash's own unit tests (src/bin/obash), which cargo runs as the bin target.
rust_test(
    name = "obash_test",
    crate = ":obash",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "pi-shell_doc_test",
    crate = ":pi-shell",
    deps = all_crate_deps(normal_dev = True),
)
