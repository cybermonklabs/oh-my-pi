"""Repository rule fetching pinned CMake and Ninja release binaries for build scripts.

Two third-party build scripts spawn host tools by name from their PATH:
opusic-sys configures its bundled Opus with `cmake` (through the cmake crate)
and picks the Ninja generator when `ninja --version` runs, and
wasmtime-c-api-impl (tree-sitter's `wasm` feature) runs `cmake -P`. Under
--incompatible_strict_action_env that PATH is the one the crate annotations in
MODULE.bazel give them, and a list of host directories there finds the tools
only where some machine happened to install them (not under mise, asdf, a nix
profile or ~/.local/bin). This repo is the exec host's own copy instead: the
same CMake and Ninja releases the omp-ci template pins
(infra/vmon/omp_ci_template.py), at one exec-root path on every machine, so the
build-script actions run the same cmake and ninja and key the same everywhere.
The other tools cmake looks up (the binutils, and the compiler where no Bazel
cc toolchain names one) still come from the system dirs on that PATH.

These are the upstream release binaries, so the exec host needs what they need:
glibc 2.17 for linux-x64 CMake and 2.28 for linux-arm64 CMake, and glibc 2.15
plus a libstdc++ with GLIBCXX_3.4.21 for linux-x64 Ninja (centos:7's is too
old). A musl host (alpine) runs none of them.

    bin/cmake, bin/ninja   the executables the annotations put first on PATH
    share/cmake-<minor>/   CMake's module tree (Help/ pruned), which cmake
                           finds beside bin/cmake (its CMAKE_ROOT)

Downloads go through repository_ctx.download_and_extract with pinned sha256s
(Kitware's cmake-<version>-SHA-256.txt; the digests GitHub lists for the Ninja
release assets), so they land in Bazel's repository cache.
"""

def _host_key(rctx):
    os_name = rctx.os.name.lower()
    arch = rctx.os.arch.lower()
    if os_name.startswith("linux"):
        host_os = "linux"
    elif os_name.startswith("mac") or os_name.startswith("darwin"):
        host_os = "macos"
    else:
        fail("bazel/toolchains/cmake.bzl: unsupported exec host OS: " + rctx.os.name)
    if arch in ("amd64", "x86_64", "x64"):
        host_cpu = "x64"
    elif arch in ("aarch64", "arm64"):
        host_cpu = "arm64"
    else:
        fail("bazel/toolchains/cmake.bzl: unsupported exec host CPU: " + rctx.os.arch)
    return host_os + "-" + host_cpu

_BUILD = """\
# Generated by //bazel/toolchains:cmake.bzl: CMake {cmake_version} and Ninja
# {ninja_version} for the {host} exec host. Consumed by the opusic-sys and
# wasmtime-c-api-impl crate annotations in MODULE.bazel.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = ["bin/cmake", "bin/ninja"] + glob(["share/**"]),
)
"""

def _cmake_ninja_impl(rctx):
    key = _host_key(rctx)
    cmake_dist = rctx.attr.cmake_dists.get(key)
    ninja_dist = rctx.attr.ninja_dists.get(key)
    if not cmake_dist or not ninja_dist:
        fail("bazel/toolchains/cmake.bzl: no pinned CMake/Ninja archive for {} hosts (pinned: {})".format(
            key,
            ", ".join(rctx.attr.cmake_dists.keys()),
        ))
    cmake_version = rctx.attr.cmake_version
    cmake_suffix, cmake_sha256 = cmake_dist
    cmake_prefix = "cmake-{}-{}".format(cmake_version, cmake_suffix)
    rctx.report_progress("Downloading CMake {} ({})".format(cmake_version, cmake_suffix))
    rctx.download_and_extract(
        url = "https://github.com/Kitware/CMake/releases/download/v{}/{}.tar.gz".format(cmake_version, cmake_prefix),
        sha256 = cmake_sha256,
        # The macOS archive is an app bundle: CMake.app/Contents/{bin,share}.
        stripPrefix = cmake_prefix + ("/CMake.app/Contents" if key.startswith("macos") else ""),
    )
    ninja_asset, ninja_sha256 = ninja_dist
    rctx.report_progress("Downloading Ninja {} ({})".format(rctx.attr.ninja_version, ninja_asset))
    rctx.download_and_extract(
        url = "https://github.com/ninja-build/ninja/releases/download/v{}/{}".format(rctx.attr.ninja_version, ninja_asset),
        sha256 = ninja_sha256,
        output = "bin",
    )

    # Keep bin/{cmake,ninja} and share/cmake-<minor> without its Help/ (the
    # reStructuredText docs, over half the tree); drop the GUI, ctest, cpack,
    # docs, man pages and desktop files.
    share_name = "cmake-" + ".".join(cmake_version.split(".")[:2])
    for entry in rctx.path(".").readdir():
        if entry.basename not in ("bin", "share"):
            rctx.delete(entry)
    for entry in rctx.path("bin").readdir():
        if entry.basename not in ("cmake", "ninja"):
            rctx.delete(entry)
    for entry in rctx.path("share").readdir():
        if entry.basename != share_name:
            rctx.delete(entry)
    rctx.delete(rctx.path("share").get_child(share_name).get_child("Help"))

    rctx.file("BUILD.bazel", _BUILD.format(
        cmake_version = cmake_version,
        ninja_version = rctx.attr.ninja_version,
        host = key,
    ), executable = False)

    # A pure function of the pinned URLs+sha256s and the deterministic prune.
    return rctx.repo_metadata(reproducible = True)

cmake_ninja_repository = repository_rule(
    implementation = _cmake_ninja_impl,
    doc = "Pinned CMake and Ninja release binaries for the exec host.",
    attrs = {
        # host key -> [release asset suffix, sha256]
        "cmake_dists": attr.string_list_dict(default = {
            "linux-arm64": ["linux-aarch64", "2efc974dbd63b4444c0e8494b92f2e80c2d7e635b4b80eac2916985ddd8f72a6"],
            "linux-x64": ["linux-x86_64", "d6c83076c575bc00b823522ac974bda66d0af05d6ddc30e739c12385cf32c6cc"],
            "macos-arm64": ["macos-universal", "0c5d65251c14cc884bfa16bdbed3c263ce5bffe2e21c0d0d00962cb0610464fa"],
            "macos-x64": ["macos-universal", "0c5d65251c14cc884bfa16bdbed3c263ce5bffe2e21c0d0d00962cb0610464fa"],
        }),
        "cmake_version": attr.string(default = "4.4.3"),
        # host key -> [release asset, sha256]
        "ninja_dists": attr.string_list_dict(default = {
            "linux-arm64": ["ninja-linux-aarch64.zip", "fd2cacc8050a7f12a16a2e48f9e06fca5c14fc4c2bee2babb67b58be17a607fc"],
            "linux-x64": ["ninja-linux.zip", "5749cbc4e668273514150a80e387a957f933c6ed3f5f11e03fb30955e2bbead6"],
            "macos-arm64": ["ninja-mac.zip", "c99048673aa765960a99cf10c6ddb9f1fad506099ff0a0e137ad8960a88f321b"],
            "macos-x64": ["ninja-mac.zip", "c99048673aa765960a99cf10c6ddb9f1fad506099ff0a0e137ad8960a88f321b"],
        }),
        "ninja_version": attr.string(default = "1.13.2"),
    },
)
